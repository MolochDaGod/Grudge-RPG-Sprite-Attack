# ==============================================
# GRUDGE RPG SPRITE ATTACK — Environment
# ==============================================
# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=5000

# Local Postgres (docker-compose) — sprite-attack game data only
DATABASE_URL=postgresql://grudge:grudge@localhost:5432/grudge_warlords

# ── Grudge Studio fleet (production defaults in fleetConfig.ts) ──
# Canonical public site: https://water.grudge-studio.com
GRUDGE_GAME_DATA_API=https://grudge-api-production-0d46.up.railway.app
GRUDGE_ID_API=https://id.grudge-studio.com

# Browser (Vite) — leave API empty for same-origin /api proxy in dev
VITE_AUTH_GATEWAY_URL=https://id.grudge-studio.com
VITE_GAME_DATA_API=https://grudge-api-production-0d46.up.railway.app
VITE_PVP_SERVER_URL=https://grudge-pvp-server-production.up.railway.app
VITE_APP_ORIGIN=http://localhost:5000
VITE_ASSETS_URL=https://assets.grudge-studio.com
VITE_OBJECTSTORE_URL=https://objectstore.grudge-studio.com

AI_INTEGRATIONS_OPENAI_API_KEY=
MESHY_API_KEY=
SESSION_SECRET=